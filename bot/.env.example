# Telegram bot token from @BotFather
BOT_TOKEN=

# PULSE backend base URL (no trailing /api — the bot appends it itself)
BACKEND_URL=http://localhost:4000

# MUST be exactly the same value as BOT_INTERNAL_SECRET in backend/.env —
# this is how the backend trusts requests coming from this bot (instead of a
# JWT) and resolves the PULSE user from x-telegram-id.
BOT_INTERNAL_SECRET=
