PORT=4000

# Leave empty for local dev — backend falls back to an in-memory MongoDB.
# Set a real MongoDB Atlas connection string for deploy.
MONGO_URI=

# Any long random string. Set a real one for production.
JWT_SECRET=

BOT_TOKEN=
# Any long random string — shared secret between backend and bot (internal auth only).
BOT_INTERNAL_SECRET=
# Telegram bot username (without @), used to build the /start deep link.
BOT_USERNAME=pulse_health_bot

BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Optional — enables real LLM replies in PULSE AI via Vercel AI Gateway.
# Leaving this empty is fine: PULSE AI falls back to a rule-based assistant
# that still reads real backend data.
AI_GATEWAY_API_KEY=
